{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "server/**/*.ts", "server/**/*.js", "api/**/*.ts", "shared/**/*.js", "server.js"],
  "exclude": ["**/*.test.*", "node_modules"]
}
