{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/storage.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/storage/:path*",
      "destination": "/api/storage"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
